 "sections": {
  "description": {
   "text": "Creates a class for the defstruct.\nBy default, an instance of a defstruct does not have a class. You cannot use Instance to instantiate this class. Use the instantiation function created by defstruct.\nUsing addDefstructClass to create a class for a defstruct allows you to define methods for a defstruct."
  },
  "arguments": {
   "root": {
    "title": null,
    "items": [
     {
      "name": "s_name",
      "desc": "The name of the defstruct.",
      "values": null
     }
    ]
   },
   "lists": [],
   "text": "s_name\nThe name of the defstruct."
  },
  "returns": {
   "items": [
    {
     "value": "u_classObject",
     "desc": "The class object."
    }
   ],
   "text": "u_classObject\nThe class object."
  },
  "example": {
   "text": "defstruct( card rank suit ) => t\nx = _card( ?rank 8 ?suit \"spades\" )\n=> array[4]:3897312\ntype( x ) => card\nfindClass( 'card ) => nil\nclassOf( x ) => nil\naddDefstructClass( card ) => funobj:0x1c98f8\nclassName( classOf( x )) => card"
  },
